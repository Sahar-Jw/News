# ---- Database (MySQL 8 / MariaDB 10.4+) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=nn
DB_LOGGING=false

# ---- Auth ----
# long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=chBUBWUIBDiuBIBFIAOBVKnccPJD0HPJWEGOVNKASFNOGHBIDGHNSI
JWT_EXPIRES_IN=100h
# cookie used in addition to the Authorization: Bearer header
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DEFAULT_ROLE_CODE=registered

# ---- Server ----
PORT=3001
# comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# public URL of the website (used by the share links to redirect to the article); defaults to the first CORS origin
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=true
STORAGE_DIR=./storage
RUN_MIGRATIONS_ON_START=false

# ---- First admin (used only by the seed script) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin@123
SEED_ADMIN_NAME=System Administrator

# ---- Optional local/demo seed data ----
# Set true only for local development or a demo installation.
SEED_DEMO_DATA=false
# Required (8+ characters) when SEED_DEMO_DATA=true; shared by the sample editor and reader accounts.
DEMO_USERS_PASSWORD=


